# Copy to .env and fill in values before running docker compose.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional — enables AI chat panel
ANTHROPIC_API_KEY=

# Optional — Claude model for AI chat (default: claude-sonnet-4-6)
AI_MODEL=

# Set to "development" to allow plain-HTTP session cookies locally
ENVIRONMENT=development

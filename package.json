{
  "name": "quarto-ed-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Tailwind CSS + esbuild build for the quarto-ed editor UI.",
  "scripts": {
    "build:css": "tailwindcss -i app/static/src/input.css -o app/static/app.css --minify",
    "watch:css": "tailwindcss -i app/static/src/input.css -o app/static/app.css --watch",
    "build:js": "esbuild app/static/src/editor.js --bundle --minify --splitting --format=esm --target=es2020 --outdir=app/static/dist",
    "watch:js": "esbuild app/static/src/editor.js --bundle --splitting --format=esm --target=es2020 --outdir=app/static/dist --watch",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.35.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ansi_up": "^5.2.0",
    "codemirror": "^6.0.1"
  }
}

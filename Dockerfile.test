# Extends the production image with test dependencies and the test suite.
# The production image is never modified — this layer is only used in CI.
ARG BASE_IMAGE=app:ci
FROM $BASE_IMAGE

# Test-only Python dependencies (pytest, pytest-asyncio, httpx, aiosqlite, pytest-cov)
COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir --break-system-packages -r /tmp/requirements-test.txt

# Copy test suite and config
COPY tests /app/tests
COPY pytest.ini /app/pytest.ini

# Create a non-root user for the second test pass (requires_non_root sandbox tests).
# /app must be world-readable so testrunner can access the source and test files.
RUN useradd -m -u 1001 testrunner && chmod -R o+rX /app

WORKDIR /app

# Two-pass test run:
#   Pass 1 (root):     full suite — requires_root sandbox tests run, requires_non_root skip
#   Pass 2 (non-root): security module only — requires_non_root tests now run, requires_root skip
#   CI=true skips pass 2 (su testrunner is unavailable in GitHub Actions runners).
#   scripts/run-tests.sh runs pass 2 via a separate `docker run --user testrunner` call
#   and is unaffected by this guard.
CMD ["bash", "-c", \
  "python3.11 -m pytest tests/ --tb=short -q && \
   if [ -n \"${CI:-}\" ]; then \
     echo '=== Pass 2: skipped (CI environment detected — run scripts/run-tests.sh locally for full coverage) ==='; \
   else \
     echo '=== Pass 2: non-root sandbox tests ===' && \
     su testrunner -s /bin/bash -c 'python3.11 -m pytest /app/tests/test_security.py -p no:cacheprovider --tb=short -q --no-cov --rootdir=/app'; \
   fi"]
